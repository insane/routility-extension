{
  "manifest_version": 3,
  "name": "RoUtility",
  "version": "1.1.5",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting",
    "notifications",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.roblox.com/*",
    "https://create.roblox.com/*",
    "https://apis.roblox.com/*",
    "https://users.roblox.com/*",
    "https://trades.roblox.com/*",
    "https://economy.roblox.com/*",
    "https://thumbnails.roblox.com/*",
    "https://assetdelivery.roblox.com/*",
    "https://accountinformation.roblox.com/*",
    "https://gamejoin.roblox.com/*",
    "https://routility.io/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "src/core/net.js",
        "src/core/life.js",
        "src/core/i18n.js",
        "src/core/skeleton.js",
        "src/features/classic-roblox/classicnames.js",
        "src/features/fun/fun.js", "src/features/items/catalogsearch.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "src/core/ui.js",
        "src/features/items/chart.js",
        "src/features/items/owners.js",
        "src/features/profile/profile.js",
        "src/features/inventory/inventory.js",
        "src/features/trading/trades.js",
        "src/features/friends/friends.js",
        "src/features/friends/requests.js",
        "src/features/robux/transactions.js",
        "src/features/robux/spending.js",
        "src/features/profile/early.js",
        "src/features/profile/classic.js",
        "src/features/search/search.js",
        "src/features/communities/communities.js",
        "src/features/avatar/avatar.js",
        "src/features/avatar/thumbcam.js",
        "src/features/avatar/accadjust.js",
        "src/features/avatar/rotator.js",
        "src/features/fun/funoutfits.js",
        "src/features/avatar/skintone.js",
        "src/features/profile/mutual.js",
        "src/features/badges/badges.js",
        "src/features/badges/badgemanage.js",
        "src/features/inventory/invsearch.js",
        "src/features/profile/listorder.js",
        "src/features/games/games.js",
        "src/features/profile/hovercard.js",
        "src/features/general/misc.js",
        "src/features/robux/plus.js",
        "src/features/robux/sendrobux.js",
        "src/features/account/account.js",
        "src/features/games/unavailable.js",
        "src/features/nav/oldnav.js",
        "src/features/trading/calc.js",
        "src/features/trading/tradeads.js",
        "src/features/items/itemcard.js",
        "src/features/home/home.js",
        "src/features/games/extras.js",
        "src/features/forum/forum.js",
        "src/features/items/owned.js",
        "src/features/items/itemextras.js",
        "src/features/explorer/rbxm.js",
        "src/features/explorer/scan.js",
        "src/features/explorer/explorer.js",
        "src/features/profile/wearing.js",
        "src/features/avatar/tryon.js",
        "src/features/items/pricealert.js",
        "src/features/items/hiddenitem.js",
        "src/features/items/purchaselock.js",
        "src/features/chat/bot.js",
        "src/features/chat/chatsize.js",
        "src/features/themes/scrollbar.js",
        "src/core/compat.js",
        "src/core/content.js"
      ],
      "css": [
        "styles/routility.css",
        "styles/explorer.css",
        "styles/classic.css",
        "styles/skeleton.css",
        "styles/forum.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.roblox.com/my/account*"
      ],
      "js": [
        "src/settings/freeitems.js",
        "src/settings/settings.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.roblox.com/users/*/profile*",
        "https://www.roblox.com/request-error*"
      ],
      "js": [
        "src/features/profile/early.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "src/features/fun/fun-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.roblox.com/*"
      ],
      "js": [
        "src/features/robux/send-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.roblox.com/my/avatar*"
      ],
      "js": [
        "src/features/avatar/avatar-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.roblox.com/users/*/profile*"
      ],
      "js": [
        "src/features/profile/profile-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.roblox.com/transactions*"
      ],
      "js": [
        "src/features/robux/transactions-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.roblox.com/games/*"
      ],
      "js": [
        "src/features/games/servers-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.roblox.com/users/*/inventory*",
        "https://www.roblox.com/users/inventory*"
      ],
      "js": [
        "src/features/inventory/inventory-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://create.roblox.com/*"
      ],
      "js": [
        "src/core/net.js",
        "src/core/life.js",
        "src/core/i18n.js",
        "src/core/ui.js",
        "src/features/explorer/rbxm.js",
        "src/features/explorer/scan.js",
        "src/features/explorer/explorer.js",
        "src/create/create.js"
      ],
      "css": [
        "styles/explorer.css",
        "styles/create.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/logo.png",
        "assets/icons/social.svg",
        "assets/flags/*",
        "assets/icons/forum/*",
        "vendor/*",
        "src/preview/*",
        "src/preview/mesh.js",
        "assets/icons/tags/*",
        "assets/icons/calc/*",
        "assets/icons/icon48.png",
        "assets/icons/icon128.png",
        "assets/icons/bot.png"
      ],
      "matches": [
        "https://www.roblox.com/*"
      ]
    },
    {
      "resources": [
        "assets/icons/logo.png"
      ],
      "matches": [
        "https://create.roblox.com/*"
      ]
    }
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "RoUtility",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "gamejoin",
        "enabled": true,
        "path": "rules/rules.json"
      },
      {
        "id": "studio",
        "enabled": false,
        "path": "rules/rules-studio.json"
      },
      {
        "id": "fun",
        "enabled": false,
        "path": "rules/rules-fun.json"
      },
      {
        "id": "pages",
        "enabled": true,
        "path": "rules/rules-pages.json"
      }
    ]
  },
  "default_locale": "en"
}
